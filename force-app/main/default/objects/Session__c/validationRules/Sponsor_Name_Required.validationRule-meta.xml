<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sponsor_Name_Required</fullName>
    <active>true</active>
    <description>Una sesión patrocinada debe indicar el patrocinador.</description>
    <errorConditionFormula>Is_Sponsored__c &amp;&amp; ISBLANK(Sponsor_Name__c)</errorConditionFormula>
    <errorDisplayField>Sponsor_Name__c</errorDisplayField>
    <errorMessage>Indica el nombre del patrocinador.</errorMessage>
</ValidationRule>
