<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <classAccesses>
        <apexClass>ShipmentTrackingController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <description>Usuario invitado del sitio de rastreo. Sin acceso a objetos: todo pasa por ShipmentTrackingController, que aplica RN-01, RN-02 y RN-03. Incluye el principal de EntregaYa para descargar comprobantes.</description>
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>EntregaYa-EntregaYaApi</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>
    <hasActivationRequired>false</hasActivationRequired>
    <label>RutaCargo - Sitio público (invitado)</label>
    <!-- Salesforce exige lectura de UserExternalCredential para usar cualquier External Credential en una callout. -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>UserExternalCredential</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
</PermissionSet>
